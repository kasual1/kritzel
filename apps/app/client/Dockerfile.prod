# Packages a client build made beforehand (the deploy workflow runs `npm run build -- --configuration=production`
# in CI). Building Angular on the production instance is too slow for its resources.
FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*
RUN rm -f /etc/nginx/conf.d/*

# Angular 17+ (application builder) outputs to dist/<project>/browser by default
COPY dist/client/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN test -s /usr/share/nginx/html/index.html && test -s /usr/share/nginx/html/ngsw-worker.js

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
