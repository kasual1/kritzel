              "type": "string",
            },
            "objectId": {
              "description": "Object ID from observe_canvas.",
              "type": "string",
            },
            "offset": {
              "additionalProperties": false,
              "description": "Offset from the anchor in world units, in the object's unrotated frame.",
              "properties": {
                "x": {
                  "description": "World x.",
                  "type": "number",
                },
                "y": {
                  "description": "World y.",
                  "type": "number",
                },
              },
              "required": [
