                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
              },
              "type": "object",
            },
            "opacity": {
              "description": "0 (transparent) to 1 (opaque).",
              "type": "number",
            },
            "strokeColor": {
              "description": "Line color. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "strokeWidth": {
              "description": "Line width. Greater than 0.",
              "type": "number",
