                        "open",
                        "diamond",
                        "circle",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
                "start": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "description": "Whether this end has an arrow head.",
                      "type": "boolean",
                    },
                    "size": {
                      "description": "Head size. Defaults to 3 x the stroke width. Greater than 0.",
                      "type": "number",
                    },
                    "style": {
                      "description": "Defaults to 'triangle'.",
                      "enum": [
                        "triangle",
                        "open",
