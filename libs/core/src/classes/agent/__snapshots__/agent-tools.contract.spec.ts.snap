            "description": "Object ID from observe_canvas.",
            "type": "string",
          },
          "minItems": 2,
          "type": "array",
        },
      },
      "required": [
        "objectIds",
      ],
      "type": "object",
    },
    "name": "group_objects",
  },
  {
    "description": "Dissolves top-level groups; their children keep their place. Returns the children's IDs. Works as the user: the user's selection follows the change.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "objectIds": {
          "description": "IDs of top-level groups.",
          "items": {
            "description": "Object ID from observe_canvas.",
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "objectIds",
      ],
      "type": "object",
    },
    "name": "ungroup_objects",
  },
  {
    "description": "Moves top-level objects in the stacking order; a group moves with its children.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "objectIds": {
          "description": "IDs of top-level objects (objects without parentId).",
          "items": {
            "description": "Object ID from observe_canvas.",
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "order": {
          "description": "'front' or 'back' moves them above or below all other objects, 'forward' or 'backward' one layer.",
          "enum": [
            "front",
            "back",
            "forward",
            "backward",
          ],
          "type": "string",
        },
      },
      "required": [
        "objectIds",
        "order",
      ],
      "type": "object",
    },
    "name": "order_objects",
  },
  {
    "description": "Draws a new shape with its top-left corner at (x, y) in world coordinates, optionally with centered text. Returns its ID.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "description": "At least 1.",
          "type": "number",
        },
        "shapeType": {
          "description": "Defaults to the user's current shape type.",
          "enum": [
            "rectangle",
            "ellipse",
            "triangle",
          ],
          "type": "string",
        },
        "style": {
          "additionalProperties": false,
          "description": "Unset fields use the user's current shape tool settings.",
          "properties": {
            "fillColor": {
              "description": "Fill. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "fontColor": {
              "description": "Text color. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "fontFamily": {
              "description": "Font family name.",
              "type": "string",
            },
            "fontSize": {
              "description": "Font size. Greater than 0.",
              "type": "number",
            },
            "opacity": {
              "description": "0 (transparent) to 1 (opaque).",
              "type": "number",
            },
            "strokeColor": {
              "description": "Outline. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "strokeWidth": {
              "description": "Outline width. Greater than 0.",
              "type": "number",
            },
          },
          "type": "object",
        },
        "text": {
          "description": "Text inside the shape. \\n starts a new paragraph.",
          "type": "string",
        },
        "width": {
          "description": "At least 1.",
          "type": "number",
        },
        "x": {
          "description": "Left edge.",
          "type": "number",
        },
        "y": {
          "description": "Top edge.",
          "type": "number",
        },
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
      ],
      "type": "object",
    },
    "name": "create_shape",
  },
  {
    "description": "Places a new text object with its top-left corner at (x, y) and types the text. Its size follows the text. Returns its ID.",
