            "strokeColor": {
              "description": "Outline of shapes, color of pen strokes and lines. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "strokeWidth": {
              "description": "Outline or stroke width. Greater than 0.",
              "type": "number",
            },
          },
          "type": "object",
        },
      },
      "required": [
        "objectIds",
        "style",
      ],
      "type": "object",
    },
    "name": "k_set_style",
  },
  {
    "description": "Places an image drawn as SVG markup you write (illustrations, icons, diagrams) with its top-left corner at (x, y). Without width and height, the image's own size is used, fitted into 300×300. Returns its ID.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "description": "Height; give it together with width. Greater than 0.",
          "type": "number",
        },
        "name": {
          "description": "Short title shown on the image.",
          "type": "string",
        },
        "svg": {
          "description": "A complete <svg> element with xmlns and viewBox. Scripts in it never run.",
          "type": "string",
        },
        "width": {
          "description": "Width; give it together with height. Greater than 0.",
          "type": "number",
        },
        "x": {
          "description": "Left edge.",
          "type": "number",
        },
        "y": {
          "description": "Top edge.",
          "type": "number",
        },
      },
      "required": [
        "x",
        "y",
      ],
      "type": "object",
    },
    "name": "k_create_image",
  },
  {
    "description": "Places a small interactive UI widget (a counter, a timer, a poll, a mini chart, …) with its top-left corner at (x, y): your HTML, CSS and JavaScript run in a sandboxed iframe without network access, so write self-contained code without external resources (images as data: URLs) that fills the widget. The user interacts with it once it is selected. Returns its ID.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "css": {
          "description": "Styles.",
          "type": "string",
        },
        "height": {
          "description": "Height, e.g. 240. Greater than 0.",
          "type": "number",
        },
