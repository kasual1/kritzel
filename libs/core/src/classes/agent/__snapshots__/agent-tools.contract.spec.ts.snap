            "bottom-left",
          ],
          "type": "string",
        },
        "height": {
          "description": "New height. Greater than 0.",
          "type": "number",
        },
        "keepAspectRatio": {
          "description": "Defaults to true when only one of width/height is given.",
          "type": "boolean",
        },
        "objectId": {
          "description": "ID of a top-level object.",
          "type": "string",
        },
        "width": {
          "description": "New width. Greater than 0.",
          "type": "number",
        },
      },
      "required": [
        "objectId",
      ],
      "type": "object",
    },
    "name": "resize_object",
  },
  {
    "description": "Rotates a top-level object around its center.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "description": "Degrees clockwise. Absolute (0 straightens it) unless relative is true.",
          "type": "number",
        },
        "objectId": {
          "description": "ID of a top-level object.",
          "type": "string",
        },
        "relative": {
          "description": "Add angle to the current rotation.",
          "type": "boolean",
        },
      },
      "required": [
        "objectId",
        "angle",
      ],
      "type": "object",
    },
    "name": "rotate_object",
  },
  {
    "description": "Duplicates top-level objects by Alt-dragging them; group children and lines between them are copied too. Returns the copies' IDs. Works as the user: the user's selection follows the change.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "objectIds": {
          "description": "IDs of top-level objects (objects without parentId).",
