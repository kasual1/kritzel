          "description": "Body content.",
          "type": "string",
        },
        "name": {
          "description": "Short title shown on the widget.",
          "type": "string",
        },
        "script": {
          "description": "JavaScript run after the body.",
          "type": "string",
        },
        "width": {
          "description": "Width, e.g. 320. Greater than 0.",
          "type": "number",
        },
        "x": {
          "description": "Left edge.",
          "type": "number",
        },
        "y": {
          "description": "Top edge.",
          "type": "number",
        },
      },
      "required": [
        "name",
        "html",
        "x",
        "y",
        "width",
        "height",
      ],
      "type": "object",
    },
    "name": "k_create_iframe",
  },
]
