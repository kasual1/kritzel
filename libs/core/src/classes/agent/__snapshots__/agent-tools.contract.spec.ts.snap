        },
        "x": {
          "description": "Left edge.",
          "type": "number",
        },
        "y": {
          "description": "Top edge.",
          "type": "number",
        },
      },
      "required": [
        "x",
        "y",
      ],
      "type": "object",
    },
    "name": "create_image",
  },
]
