  {
    "description": "Draws a line between the centers of two objects and anchors both ends, so it follows them. Lines cannot be connected.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "Start object.",
          "type": "string",
        },
        "style": {
          "additionalProperties": false,
          "properties": {
            "arrows": {
              "additionalProperties": false,
              "description": "Arrow heads at the ends of the line.",
              "properties": {
                "end": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "description": "Whether this end has an arrow head.",
                      "type": "boolean",
                    },
                    "size": {
                      "description": "Head size. Defaults to 3 x the stroke width. Greater than 0.",
                      "type": "number",
                    },
                    "style": {
                      "description": "Defaults to 'triangle'.",
                      "enum": [
                        "triangle",
                        "open",
                        "diamond",
                        "circle",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
                "start": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "description": "Whether this end has an arrow head.",
                      "type": "boolean",
                    },
                    "size": {
                      "description": "Head size. Defaults to 3 x the stroke width. Greater than 0.",
                      "type": "number",
                    },
                    "style": {
                      "description": "Defaults to 'triangle'.",
                      "enum": [
                        "triangle",
                        "open",
                        "diamond",
                        "circle",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
              },
              "type": "object",
            },
            "opacity": {
              "description": "0 (transparent) to 1 (opaque).",
              "type": "number",
            },
            "strokeColor": {
              "description": "Line color. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "strokeWidth": {
              "description": "Line width. Greater than 0.",
              "type": "number",
            },
          },
          "type": "object",
        },
        "to": {
          "description": "End object; must differ from \`from\`.",
          "type": "string",
        },
