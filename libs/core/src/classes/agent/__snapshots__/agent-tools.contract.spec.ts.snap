  },
  {
    "description": "Changes a line's geometry with its handles: moves its start or end to a free point (detaching it from an object) or onto an object (attaching it), and curves it through a point or straightens it. Restyle lines with set_style.",
    "inputSchema": {
      "additionalProperties": false,
