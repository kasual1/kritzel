          "minItems": 1,
          "type": "array",
        },
        "scope": {
          "description": "'all' (default) or only what the user sees.",
          "enum": [
            "all",
            "viewport",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "observe_canvas",
  },
  {
