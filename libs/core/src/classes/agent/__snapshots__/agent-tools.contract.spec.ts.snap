              "description": "Line color. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "strokeWidth": {
              "description": "Line width. Greater than 0.",
              "type": "number",
            },
          },
          "type": "object",
        },
        "to": {
          "description": "End object; must differ from \`from\`.",
          "type": "string",
        },
      },
      "required": [
        "from",
        "to",
      ],
      "type": "object",
    },
    "name": "k_connect",
  },
  {
    "description": "Draws a straight or curved line or arrow from \`from\` to \`to\`, like the line tool. Each end is a free point or an object; an end on an object follows it when it moves, so one end can point at an object while the other stays put. Returns its ID.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "additionalProperties": false,
          "description": "Start. Either a free world point {x, y}, or {objectId}: the end sits at the object's center and follows it when it moves.",
          "properties": {
            "objectId": {
              "description": "Object the end attaches to. Lines cannot be ends.",
              "type": "string",
            },
            "x": {
              "description": "World x of a free end.",
              "type": "number",
            },
            "y": {
              "description": "World y of a free end.",
              "type": "number",
            },
          },
          "type": "object",
        },
        "style": {
          "additionalProperties": false,
          "properties": {
            "arrows": {
              "additionalProperties": false,
              "description": "Arrow heads at the ends of the line.",
              "properties": {
                "end": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "description": "Whether this end has an arrow head.",
                      "type": "boolean",
                    },
                    "size": {
                      "description": "Head size. Defaults to 3 x the stroke width. Greater than 0.",
                      "type": "number",
                    },
                    "style": {
                      "description": "Defaults to 'triangle'.",
                      "enum": [
                        "triangle",
                        "open",
                        "diamond",
                        "circle",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
                "start": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "description": "Whether this end has an arrow head.",
                      "type": "boolean",
                    },
                    "size": {
                      "description": "Head size. Defaults to 3 x the stroke width. Greater than 0.",
                      "type": "number",
                    },
                    "style": {
                      "description": "Defaults to 'triangle'.",
                      "enum": [
                        "triangle",
                        "open",
                        "diamond",
                        "circle",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
              },
              "type": "object",
            },
            "opacity": {
              "description": "0 (transparent) to 1 (opaque).",
              "type": "number",
            },
            "strokeColor": {
              "description": "Line color. Any CSS color, e.g. "#1e88e5" or "tomato".",
              "type": "string",
            },
            "strokeWidth": {
              "description": "Line width. Greater than 0.",
              "type": "number",
            },
          },
          "type": "object",
        },
        "through": {
          "additionalProperties": false,
          "description": "World point the line curves through, halfway along it. Straight when left out.",
          "properties": {
            "x": {
              "description": "World x.",
              "type": "number",
            },
            "y": {
              "description": "World y.",
              "type": "number",
            },
          },
          "required": [
            "x",
            "y",
          ],
          "type": "object",
        },
        "to": {
          "additionalProperties": false,
          "description": "End; not the same object as \`from\`. Either a free world point {x, y}, or {objectId}: the end sits at the object's center and follows it when it moves.",
          "properties": {
            "objectId": {
              "description": "Object the end attaches to. Lines cannot be ends.",
              "type": "string",
            },
            "x": {
              "description": "World x of a free end.",
              "type": "number",
            },
            "y": {
              "description": "World y of a free end.",
              "type": "number",
            },
          },
          "type": "object",
        },
      },
      "required": [
        "from",
        "to",
      ],
      "type": "object",
    },
    "name": "k_draw_line",
  },
  {
    "description": "Changes a line's geometry with its handles: moves its start or end to a free point (detaching it from an object) or onto an object (attaching it), and curves it through a point or straightens it. Restyle lines with set_style.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "additionalProperties": false,
          "description": "New start. Either a free world point {x, y}, or {objectId}: the end sits at the object's center and follows it when it moves.",
          "properties": {
            "objectId": {
              "description": "Object the end attaches to. Lines cannot be ends.",
              "type": "string",
            },
            "x": {
              "description": "World x of a free end.",
              "type": "number",
            },
            "y": {
              "description": "World y of a free end.",
              "type": "number",
            },
          },
          "type": "object",
        },
        "lineId": {
          "description": "ID of a top-level line.",
          "type": "string",
        },
        "straight": {
          "description": "Removes the curve. Not together with \`through\`.",
          "type": "boolean",
        },
        "through": {
          "additionalProperties": false,
          "description": "World point the line curves through, halfway along it.",
          "properties": {
            "x": {
              "description": "World x.",
              "type": "number",
            },
            "y": {
              "description": "World y.",
              "type": "number",
            },
          },
          "required": [
            "x",
            "y",
          ],
          "type": "object",
        },
        "to": {
          "additionalProperties": false,
          "description": "New end. Either a free world point {x, y}, or {objectId}: the end sits at the object's center and follows it when it moves.",
          "properties": {
            "objectId": {
              "description": "Object the end attaches to. Lines cannot be ends.",
              "type": "string",
            },
            "x": {
              "description": "World x of a free end.",
              "type": "number",
            },
            "y": {
              "description": "World y of a free end.",
              "type": "number",
            },
          },
          "type": "object",
        },
      },
      "required": [
        "lineId",
      ],
      "type": "object",
    },
    "name": "k_edit_line",
  },
  {
    "description": "Restyles top-level objects; a group restyles its children.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "objectIds": {
          "description": "IDs of top-level objects (objects without parentId).",
          "items": {
            "description": "Object ID from observe_canvas.",
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "style": {
          "additionalProperties": false,
          "description": "At least one field. Fields that do not apply to an object are ignored.",
          "properties": {
            "arrows": {
              "additionalProperties": false,
              "description": "Arrow heads of lines to change; an end left out keeps its head.",
              "properties": {
                "end": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "description": "Whether this end has an arrow head.",
