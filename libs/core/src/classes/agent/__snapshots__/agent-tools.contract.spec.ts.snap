                      "description": "Head size. Defaults to 3 x the stroke width. Greater than 0.",
                      "type": "number",
                    },
                    "style": {
                      "description": "Defaults to 'triangle'.",
                      "enum": [
                        "triangle",
                        "open",
                        "diamond",
                        "circle",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "enabled",
                  ],
                  "type": "object",
                },
