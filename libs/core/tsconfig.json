{
  "compilerOptions": {
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "lib": [
      "dom",
      "es2022"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "types": ["jest", "node"]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
