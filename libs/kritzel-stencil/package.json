{
  "name": "kritzel-stencil",
  "version": "0.1.16",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stencil/stencil.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./dist/components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./dist/components/*": {
      "types": "./dist/components/*",
      "import": "./dist/components/*",
      "require": "./dist/components/*"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/stencil-component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "e2e": "stencil test --e2e --screenshot",
    "e2e:update-screenshots": "stencil test --e2e --screenshot --update-screenshot",
    "generate": "stencil generate",
    "clean": "rimraf dist .stencil loader node_modules",
    "bump": "npm version patch",
    "release": "npm publish"
  },
  "license": "MIT",
  "dependencies": {
    "@hocuspocus/provider": "^3.4.0",
    "@types/lodash": "^4.17.20",
    "browser-image-compression": "^2.0.2",
    "html-to-image": "^1.11.11",
    "lib0": "^0.2.98",
    "lodash": "^4.17.21",
    "perfect-freehand": "^1.2.2",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.3.0",
    "@stencil/core": "^4.41.0",
    "@stencil/react-output-target": "^1.2.0",
    "@stencil/vue-output-target": "0.11.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "fake-indexeddb": "^6.2.2",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-jasmine2": "^30.2.0",
    "puppeteer": "^24.6.1",
    "ts-jest": "^29.4.4"
  }
}
