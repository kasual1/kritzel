{
  "name": "@kritzel/vue-editor",
  "version": "0.5.9",
  "homepage": "https://kritzel.io/",
  "description": "Kritzel helps you build infinite canvas experiences with Vue.",
  "keywords": [
    "infinite canvas",
    "collaboration",
    "whiteboard",
    "drawing",
    "vue"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo \"Error: run tests from root\" && exit 1",
    "build": "npm run tsc",
    "tsc": "tsc -p . --outDir ./dist",
    "clean": "rimraf dist node_modules",
    "bump": "npm version patch",
    "release": "npm publish"
  },
  "bugs": {
    "url": "https://github.com/kritzeljs/kritzel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kritzel/editor": "^0.5.9",
    "@kritzel/engine": "^0.5.9",
    "@stencil/vue-output-target": "0.11.8"
  }
}
