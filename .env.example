# Copy this file to .env and fill in your own values. .env is gitignored.

# ngrok auth token for `npm run ngrok:*` (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN='{place_your_ngrok_authtoken}'

# Anthropic API key for the agentic canvas in apps/infographics (https://platform.claude.com/settings/keys).
# Its dev server hands the key to the page, which calls the Claude API from the browser, so only run it locally.
ANTHROPIC_API_KEY=
