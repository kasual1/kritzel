# Copy this file to .env and fill in your own values. .env is gitignored.

# ngrok auth token for `npm run ngrok:*` (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN='{place_your_ngrok_authtoken}'

# Anthropic API key for the generative UI in apps/infographics and the TEMP "Agent: Claude widget" page of the React
# demos, which only gets it from the dev server (https://platform.claude.com/settings/keys).
# Vite bundles it into the page, which calls the Claude API from the browser, so only run these apps locally.
ANTHROPIC_API_KEY=
