{
  "name": "root",
  "private": true,
  "workspaces": [
    "libs/kritzel-stencil",
    "libs/kritzel-angular",
    "libs/kritzel-react",
    "libs/kritzel-vue",
    "demos/angular",
    "demos/react",
    "demos/vue",
    "server/websocket-demo"
  ],
  "devDependencies": {
    "@ngrok/ngrok": "^1.5.2",
    "@types/node": "^22.14.1",
    "dotenv": "^17.2.2",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "clean": "node ./scripts/clean.js",
    "bump-patch": "node ./scripts/bump-patch.js",
    "bump-minor": "node ./scripts/bump-minor.js",
    "bump-major": "node ./scripts/bump-major.js",
    "test": "npm run test -w libs/kritzel-stencil",
    "e2e": "npm run e2e -w libs/kritzel-stencil",
    "e2e:update-screenshots": "npm run e2e:update-screenshots -w libs/kritzel-stencil",
    "build": "npm run build --workspaces --if-present",
    "publish": "npm run release --workspaces --if-present",
    "start": "npm run start -w libs/kritzel-stencil",
    "ngrok": "node ./ngrok/start.js",
    "demo:angular": "npm run start -w demos/angular",
    "demo:react": "npm run start -w demos/react",
    "demo:vue": "npm run start -w demos/vue",
    "server:start": "npm run start -w server/websocket-demo",
    "server:dev": "npm run start:dev -w server/websocket-demo",
    "server:debug": "npm run start:debug -w server/websocket-demo",
    "server:build": "npm run build -w server/websocket-demo",
    "docs:start": "cd website && npm run start",
    "docs:build": "cd website && npm run build",
    "docs:serve": "cd website && npm run serve"
  },
  "overrides": {
    "axios": "^0.30.0"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3"
  }
}
