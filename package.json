{
  "name": "root",
  "private": true,
  "workspaces": [
    "libs/kritzel-stencil",
    "libs/kritzel-angular",
    "libs/kritzel-react",
    "libs/kritzel-vue",
    "demos/angular",
    "demos/react",
    "demos/vue",
    "e2e/apps/angular",
    "e2e/apps/react",
    "e2e/apps/vue",
    "website",
    "websocket"
  ],
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@ngrok/ngrok": "^1.5.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.14.1",
    "dotenv": "^17.2.2",
    "typescript": "~6.0.0"
  },
  "scripts": {
    "clean": "node ./scripts/clean.js",
    "bump-patch": "node ./scripts/bump-patch.js",
    "bump-minor": "node ./scripts/bump-minor.js",
    "bump-major": "node ./scripts/bump-major.js",
    "license:keygen": "node ./scripts/license/generate-keypair.js",
    "license:sign": "node ./scripts/license/sign-license.js",
    "license:verify": "node ./scripts/license/verify-license.js",
    "test": "npm run test -w libs/kritzel-stencil",
    "build": "npm run build -w libs/kritzel-stencil && npm run build -w libs/kritzel-angular && npm run build -w libs/kritzel-react && npm run build -w libs/kritzel-vue",
    "publish": "npm run release --workspaces --if-present",
    "start": "npm run start -w libs/kritzel-stencil",
    "ngrok:stencil": "node ./ngrok/start.js --port=3333 --name=stencil-lib",
    "ngrok:website": "node ./ngrok/start.js --port=3000 --name=website",
    "demo:angular": "npm run start -w demos/angular",
    "demo:react": "npm run start -w demos/react",
    "demo:vue": "npm run start -w demos/vue",
    "ws": "npm run start -w websocket",
    "e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "e2e:angular": "npx playwright test --config=e2e/playwright.config.ts --project=e2e-angular --project=demo-angular",
    "e2e:react": "npx playwright test --config=e2e/playwright.config.ts --project=e2e-react --project=demo-react",
    "e2e:vue": "npx playwright test --config=e2e/playwright.config.ts --project=e2e-vue --project=demo-vue",
    "e2e:update-screenshots": "npx playwright test --config=e2e/playwright.config.ts --update-snapshots=all",
    "e2e:report": "npx playwright show-report e2e/playwright-report",
    "docs:start": "cd website && npm run start",
    "docs:build": "cd website && npm run build",
    "docs:serve": "cd website && npm run serve"
  },
  "overrides": {
    "axios": "^0.30.0",
    "picomatch": "^4.0.4",
    "undici": "^6.19.8"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3"
  }
}
