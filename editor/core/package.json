{
  "name": "@kritzel/editor",
  "version": "0.4.34",
  "description": "Core editor package for Kritzel UI components.",
  "homepage": "https://kritzel.io/",
  "keywords": [
    "infinite canvas",
    "collaboration",
    "whiteboard",
    "drawing",
    "editor"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/kritzel-editor/kritzel-editor.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    },
    "./dist/components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./dist/components/*": {
      "types": "./dist/components/*",
      "import": "./dist/components/*",
      "require": "./dist/components/*"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kasual1/kritzel.git"
  },
  "scripts": {
    "build": "stencil build",
    "dev": "stencil build --dev --watch --serve",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --maxWorkers=2",
    "generate": "stencil generate",
    "clean": "rimraf dist .stencil loader node_modules",
    "bump": "npm version patch",
    "release": "npm publish"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@kritzel/engine": "^0.4.34",
    "@stencil/angular-output-target": "^1.3.0",
    "@stencil/core": "^4.43.3",
    "@stencil/react-output-target": "^1.2.0",
    "@stencil/vue-output-target": "0.11.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-jasmine2": "^30.2.0",
    "ts-jest": "^29.4.4"
  },
  "peerDependencies": {
    "@kritzel/engine": "^0.4.34"
  }
}
