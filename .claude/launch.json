      "autoPort": false
    },
    {
      "name": "demos-angular",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace", "apps/demos/angular", "--", "--port", "5192"],
      "port": 5192,
      "autoPort": false
