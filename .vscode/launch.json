{
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Core Spec Test Current File",
      "cwd": "${workspaceFolder}/libs/core",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "${fileBasename}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Spec Test Current File",
      "cwd": "${workspaceFolder}/libs/engine/core",
      "program": "${workspaceFolder}/node_modules/@stencil/core/bin/stencil",
      "args": ["test", "--spec", "--", "${fileBasename}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}